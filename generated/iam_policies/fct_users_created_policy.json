{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAirflowToExecuteHiveQuery",
      "Effect": "Allow",
      "Action": [
        "hive:ExecuteQuery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowAirflowToReadFromHiveTable",
      "Effect": "Allow",
      "Action": [
        "hive:Select"
      ],
      "Resource": "arn:aws:hive:region:account-id:table/logging_events"
    },
    {
      "Sid": "AllowAirflowToWriteToFctUsersCreatedTable",
      "Effect": "Allow",
      "Action": [
        "hive:Insert",
        "hive:CreateTable"
      ],
      "Resource": "arn:aws:hive:region:account-id:table/fct_users_created"
    },
    {
      "Sid": "AllowAirflowToLogEvents",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:region:account-id:log-group:/aws/airflow/*"
    }
  ]
}