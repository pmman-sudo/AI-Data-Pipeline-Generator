{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowAirflowToReadFromLoggingEvents",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::logging-events/*"
        },
        {
            "Sid": "AllowAirflowToWriteToFctUsersCreated",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::fct-users-created/*"
        }
    ]
}