{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadFromTable",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::example-bucket/fct_users_created/*",
        "arn:aws:s3:::example-bucket"
      ]
    },
    {
      "Sid": "WriteToDestination",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::example-destination-bucket/*",
        "arn:aws:s3:::example-destination-bucket"
      ]
    },
    {
      "Sid": "ExecuteAirflow",
      "Effect": "Allow",
      "Action": [
        "airflow:RunDag",
        "airflow:CreateDagRun"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:*"
    }
  ]
}