{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowDAGExecution",
            "Effect": "Allow",
            "Action": [
                "airflow:StartDAG",
                "airflow:StopDAG",
                "airflow:ListDAGs"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowDatabaseAccess",
            "Effect": "Allow",
            "Action": [
                "rds:DescribeDBInstances",
                "rds:DescribeDBClusters",
                "rds:DescribeDatabases"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AllowLogging",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:*:*:*"
        }
    ]
}