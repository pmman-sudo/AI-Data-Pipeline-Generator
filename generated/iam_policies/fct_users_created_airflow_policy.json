{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowFctUsersCreatedRead",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::logging-events-prod/*"
        },
        {
            "Sid": "AllowFctUsersCreatedWrite",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::fct-users-created-prod/*"
        }
    ]
}