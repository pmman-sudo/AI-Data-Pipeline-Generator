{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowFctUsersCreatedTableCreation",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::your-bucket-name/fct_users_created"
        },
        {
            "Sid": "AllowLoggingEventsTableRead",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::your-bucket-name/logging_events"
        },
        {
            "Sid": "AllowGlueDatabaseAccess",
            "Effect": "Allow",
            "Action": [
                "glue:GetDatabase",
                "glue:GetTable",
                "glue:CreateTable",
                "glue:UpdateTable"
            ],
            "Resource": "arn:aws:glue:region:account-id:database/your-database-name"
        },
        {
            "Sid": "AllowIAMPassRole",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::account-id:role/your-role-name"
        }
    ]
}