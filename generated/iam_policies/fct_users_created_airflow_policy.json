{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowFctUsersCreatedTable",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::my-bucket/fct_users_created/*"
            ]
        },
        {
            "Sid": "AllowEmrCluster",
            "Effect": "Allow",
            "Action": [
                "emr:RunJobFlow",
                "emr:DescribeCluster",
                "emr:ListClusters",
                "emr:DescribeStep",
                "emr:ListSteps"
            ],
            "Resource": [
                "arn:aws:emr:::cluster/*"
            ]
        },
        {
            "Sid": "AllowFctUsersCreatedTableMetadata",
            "Effect": "Allow",
            "Action": [
                "glue:GetTable",
                "glue:GetTables",
                "glue:UpdateTable"
            ],
            "Resource": [
                "arn:aws:glue:::table/my-database/fct_users_created"
            ]
        }
    ]
}