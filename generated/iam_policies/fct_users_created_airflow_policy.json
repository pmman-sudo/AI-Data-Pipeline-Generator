{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowCreateTable",
            "Effect": "Allow",
            "Action": "hive:CreateTable",
            "Resource": "arn:aws:hive:REGION:ACCOUNT_ID:table/PROD/fct_users_created"
        },
        {
            "Sid": "AllowLoadData",
            "Effect": "Allow",
            "Action": "hive:LoadData",
            "Resource": "arn:aws:hive:REGION:ACCOUNT_ID:table/PROD/fct_users_created"
        },
        {
            "Sid": "AllowGetTable",
            "Effect": "Allow",
            "Action": "hive:GetTable",
            "Resource": "arn:aws:hive:REGION:ACCOUNT_ID:table/PROD/fct_users_created"
        },
        {
            "Sid": "AllowListTables",
            "Effect": "Allow",
            "Action": "hive:ListTables",
            "Resource": "arn:aws:hive:REGION:ACCOUNT_ID:database/PROD"
        }
    ]
}