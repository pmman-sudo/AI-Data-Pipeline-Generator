{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "dbtExecutionPolicy",
            "Effect": "Allow",
            "Action": [
                "glue:GetDatabase",
                "glue:GetPartitions",
                "glue:GetPartition",
                "glue:GetTable",
                "glue:GetTables",
                "glue:GetTableVersions",
                "glue:GetTableVersion"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Sid": "dbtExecutionPolicy",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::your-bucket-name/*"
            ]
        }
    ]
}