{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DbtModelExecution",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::your-bucket-name",
        "arn:aws:s3:::your-bucket-name/*"
      ]
    },
    {
      "Sid": "DbtModelReadFromLoggingEvents",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::your-logging-events-bucket-name/*"
    },
    {
      "Sid": "DbtModelWriteToFctUsersCreated",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::your-fct-users-created-bucket-name/*"
    }
  ]
}